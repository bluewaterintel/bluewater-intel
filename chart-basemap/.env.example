# Supabase Storage S3 connection
# Dashboard -> Project Settings -> Storage -> S3 Connection
SUPABASE_S3_ENDPOINT="https://<project-ref>.storage.supabase.co/storage/v1/s3"
SUPABASE_S3_REGION="us-east-1"
SUPABASE_S3_ACCESS_KEY="your-access-key-id"
SUPABASE_S3_SECRET_KEY="your-secret-access-key"

# Bucket + versioned prefix the tiles upload under
TILE_BUCKET="chart-tiles"
TILE_PREFIX="chart/v1"
