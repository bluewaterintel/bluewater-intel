# Client build (Netlify: Site settings → Environment variables)
SUPABASE_URL=https://YOURPROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only — never commit or expose in the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_PASSWORD=your-database-password-here
SUPABASE_ACCESS_TOKEN=your-supabase-cli-token
ANTHROPIC_API_KEY=your-anthropic-key
BRIEF_MODEL=claude-haiku-4-5

# Stripe (Supabase Edge Function secrets — use sk_live_... for production)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_...
STRIPE_PRICE_ANNUAL=price_...
# Optional — if unset, stripe-portal auto-creates a portal config with plan upgrades enabled.
STRIPE_PORTAL_CONFIG_ID=bpc_...
# Lifetime / per-port packs are discontinued — checkout offers only the Pro subscription.
APP_URL=https://your-app.netlify.app

# iOS In-App Purchase (RevenueCat — bridges StoreKit to Supabase entitlements)
# Public iOS SDK key from RevenueCat dashboard → Project → API keys → Apple
# Xcode Cloud: also add SUPABASE_URL, SUPABASE_ANON_KEY, and REVENUECAT_IOS_API_KEY
# as workflow Environment secrets (see docs/IOS.md §8.2).
REVENUECAT_IOS_API_KEY=appl_...
# Webhook auth: set the same value in RevenueCat → Integrations → Webhooks → Authorization header
REVENUECAT_WEBHOOK_AUTH=generate-a-long-random-string

# Owner alerts — Resend HTTP API (dataset drift + new-subscriber emails).
# Also used by `npm run sync:auth-smtp` to refresh Supabase Auth SMTP (signup
# confirmation + password reset). Auth mail is NOT sent via edge functions.
RESEND_API_KEY=re_...
# Sender for Supabase Auth SMTP (must be on your verified Resend domain)
AUTH_SMTP_FROM=noreply@bluewaterintel.com
ALERT_EMAIL=info@bluewaterintel.com
ALERT_FROM=Bluewater Intel <alerts@bluewaterintel.com>

# Dataset drift monitor — shared secret pg_cron uses to trigger the scheduled
# health run (any long random string; must match the cron job header).
CRON_SECRET=generate-a-long-random-string
